# --- LLM (OpenRouter) --- https://openrouter.ai/keys
OPENROUTER_API_KEY=
PROPSCOUT_MODEL=deepseek/deepseek-v4.1-flash
# Comma-separated fallbacks tried by OpenRouter if the primary errors
PROPSCOUT_FALLBACK_MODELS=qwen/qwen3.8-flash,google/gemini-2.5-flash-lite

# --- Telegram alerts (optional) ---
# 1. Message @BotFather -> /newbot -> copy token
# 2. Send your bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scraping (optional) ---
# PROPSCOUT_PROXY=http://user:pass@host:port

# --- Finance assumptions (defaults shown) ---
# PROPSCOUT_INTEREST_RATE=0.065
# PROPSCOUT_DOWN_PAYMENT_PCT=0.20
# PROPSCOUT_LOAN_YEARS=30
# PROPSCOUT_CLOSING_COST_PCT=0.03
# PROPSCOUT_INSURANCE_PCT=0.006
# PROPSCOUT_PROPERTY_TAX_PCT=0.011
# PROPSCOUT_VACANCY_PCT=0.06
# PROPSCOUT_MAINTENANCE_PCT=0.08
# PROPSCOUT_CAPEX_PCT=0.05
# PROPSCOUT_MANAGEMENT_PCT=0.08
